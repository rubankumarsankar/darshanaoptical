# Database Connection URL (TiDB Cloud / MySQL)
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/darshana_optical"

# Secret key for internal admin API calls (GET /api/appointments, GET /api/inquiries)
# Generate a strong random value: openssl rand -hex 32
ADMIN_API_SECRET="your-strong-secret-here"

# Secret used to sign admin session cookies (app/lib/admin/session.ts)
# Generate a strong random value: openssl rand -hex 32
SESSION_SECRET="your-strong-secret-here"

# SMTP — Gmail with App Password (generate at myaccount.google.com → Security → App Passwords)
SMTP_FROM="yourshop@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Cloudflare R2 (S3-compatible) — product image storage (app/lib/r2.ts)
# Create a bucket + API token at dash.cloudflare.com → R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="darshana-optical-uploads"
# Public base URL for the bucket: either the bucket's r2.dev public URL,
# or a custom domain mapped to it. No trailing slash.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# ─── Seed passwords (db/migrate.mjs, optional) ───────────────
# Used only when seeding a brand-new database. If unset, migrate.mjs generates a
# random password per user and prints it once. Never commit real values.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_STAFF_PASSWORD=
